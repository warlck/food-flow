# Build the React application
FROM node:20-alpine AS build_frontend
ARG BUILD_REF
ARG VITE_API_URL
ARG VITE_STRIPE_PUBLISHABLE_KEY

# Update packages to fix vulnerabilities
RUN apk update && apk upgrade --no-cache

# Set working directory
WORKDIR /app

# Copy package files
COPY api/frontends/food-flow-online-hub/package*.json ./
COPY api/frontends/food-flow-online-hub/package-lock.json ./

# Install dependencies
RUN npm ci --legacy-peer-deps

# Copy source code
COPY api/frontends/food-flow-online-hub/ ./

# Set Vite environment variables for build
ENV VITE_API_URL=${VITE_API_URL}
ENV VITE_STRIPE_PUBLISHABLE_KEY=${VITE_STRIPE_PUBLISHABLE_KEY}

# Build the application
RUN npm run build


# Serve the application with nginx
FROM nginx:alpine
ARG BUILD_DATE
ARG BUILD_REF

# Remove default nginx configuration
RUN rm -rf /usr/share/nginx/html/*

# Copy built assets from build stage
COPY --from=build_frontend /app/dist /usr/share/nginx/html

# Copy nginx configuration
COPY infra/docker/nginx.conf /etc/nginx/conf.d/default.conf

# Add non-root user
RUN addgroup -g 1000 -S frontend && \
    adduser -u 1000 -h /app -G frontend -S frontend && \
    chown -R frontend:frontend /usr/share/nginx/html && \
    chown -R frontend:frontend /var/cache/nginx && \
    chown -R frontend:frontend /var/log/nginx && \
    chown -R frontend:frontend /etc/nginx/conf.d && \
    touch /var/run/nginx.pid && \
    chown -R frontend:frontend /var/run/nginx.pid

USER frontend

EXPOSE 8080

CMD ["nginx", "-g", "daemon off;"]

LABEL org.opencontainers.image.created="${BUILD_DATE}" \
      org.opencontainers.image.title="food-flow-online-hub" \
      org.opencontainers.image.authors="Adil Kanzitdinov <adil@codecrafters.com>" \
      org.opencontainers.image.source="https://github.com/warlck/food-flow/tree/master" \
      org.opencontainers.image.revision="${BUILD_REF}" \
      org.opencontainers.image.vendor="Codecrafters"
